<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/do_key"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="DO"
            style="@style/keyStyle"
            android:backgroundTint="@color/red"
            android:textSize="30dp"
            android:onClick="playDo"
            />
        <Button
            android:id="@+id/re_key"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="RE"
            style="@style/keyStyle"
            android:backgroundTint="@color/orange"
            android:textSize="30dp"
            android:onClick="playRe"
            />
        <Button
            android:id="@+id/mi_key"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="MI"
            style="@style/keyStyle"
            android:backgroundTint="@color/yellow"
            android:textSize="30dp"
            android:onClick="playMi"
            />
        <Button
            android:id="@+id/fa_key"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="FA"
            style="@style/keyStyle"
            android:backgroundTint="@color/green"
            android:textSize="30dp"
            android:onClick="playFa"
            />
        <Button
            android:id="@+id/sol_key"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="SOL"
            style="@style/keyStyle"
            android:backgroundTint="@color/turquoise"
            android:textSize="30dp"
            android:onClick="playSol"
            />
        <Button
            android:id="@+id/la_key"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="LA"
            style="@style/keyStyle"
            android:backgroundTint="@color/blue"
            android:textSize="30dp"
            android:onClick="playLa"
            />
        <Button
            android:id="@+id/si_key"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="SI"
            style="@style/keyStyle"
            android:backgroundTint="@color/purple"
            android:textSize="30dp"
            android:onClick="playSi"
            />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>